# Copy to .env, then replace JWT_SECRET_KEY with a unique secret (openssl rand -hex 32).
DATABASE_URL=postgresql+asyncpg://admin:secretpassword@db:5432/accident_manager
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=60
COMMUNITY_THRESHOLD=5
CONFIRMATION_MAX_DISTANCE_M=500
MIN_ACCOUNT_AGE_HOURS=0
MAX_REPORTS_PER_HOUR=5
